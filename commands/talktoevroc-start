#!/usr/bin/env bash
# Start TalkToEvroc Voice Bot (Backend + Frontend for development)
# Starts: Piper TTS HTTP server, Backend API, Frontend dev server

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.." || exit 1

# Sync Python dependencies
uv sync

# Install frontend dependencies if needed
if [ ! -d "client/node_modules" ]; then
    echo "📦 Installing frontend dependencies..."
    cd client && bun install && cd ..
fi

echo "🚀 Starting TalkToEvroc..."
echo ""
echo "📍 Piper TTS Server:    http://localhost:5000"
echo "📍 Backend API:         http://localhost:7860"
echo "📍 Frontend (Vite dev): http://localhost:5173"
echo ""
echo "Press Ctrl+C to stop all processes"
echo ""

# Trap to kill all processes on exit
cleanup() {
    echo ""
    echo "🛑 Stopping TalkToEvroc..."
    kill $PIPER_PID $BACKEND_PID $FRONTEND_PID 2>/dev/null
    wait $PIPER_PID $BACKEND_PID $FRONTEND_PID 2>/dev/null
    exit 0
}
trap cleanup SIGINT SIGTERM

# Start Piper TTS (sources script, sets PIPER_PID as direct child)
echo "🔊 Starting Piper TTS server..."
source ./start-piper.sh || exit 1
echo "✅ Piper TTS server ready!"

# Start backend
cd app
uv run python server.py &
BACKEND_PID=$!
cd ..

# Wait for backend to start
sleep 2

# Start frontend dev server
cd client
bun run dev &
FRONTEND_PID=$!
cd ..

# Wait for all processes
wait $PIPER_PID $BACKEND_PID $FRONTEND_PID
