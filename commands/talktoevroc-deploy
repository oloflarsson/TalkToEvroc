#!/usr/bin/env bash
# Deploy TalkToEvroc to production
# Pre-builds frontend locally (native arch) to avoid cross-arch Docker issues

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.." || exit 1

echo "📦 Building frontend with Bun..."
cd client
if [ ! -d "node_modules" ]; then
    bun install
fi
bun run build
cd ..

echo ""
echo "🚀 Deploying to production..."
kamal deploy
